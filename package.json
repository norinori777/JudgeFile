{
  "name": "judgefile",
  "version": "0.1.0",
  "description": "txt / md ファイル監視・抽出・ロギング基盤",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "review": "tsx src/reviewer/index.ts --config ./config.json",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "openai": "^6.38.0",
    "p-queue": "^8.0.1",
    "pdfjs-dist": "^5.7.284",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/tmp": "^0.2.6",
    "tmp": "^0.2.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
